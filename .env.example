# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# For deployment, set these as environment variables on your host.
# ------------------------------------------------------------------

# Where the contact form delivers messages. Create a free form at
# https://formspree.io and paste its ID here. Any service that accepts
# a JSON POST and replies 2xx works (EmailJS, Basin, Getform…).
VITE_CONTACT_ENDPOINT=https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID

# Public site URL — used in generated metadata (sitemap/OG/JSON-LD).
VITE_SITE_URL=https://your-domain.com

# Optional: deploy under a sub-path instead of the domain root
# (required for a GitHub Pages *project* site, e.g. /martin-omondi/).
# BASE_PATH=/martin-omondi/