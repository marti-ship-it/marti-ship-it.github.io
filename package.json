{
  "name": "martin-omondi-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Martin Omondi — Cyber Security Specialist, Network Designer and Linux Administrator. TypeScript + Vite, PWA-ready.",
  "author": "Martin Omondi",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
